<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-create-password-reset-tokens-table" author="ivan">
        <comment>Création de la table password_reset_tokens pour la réinitialisation de mot de passe</comment>

        <createTable tableName="password_reset_tokens">
            <!-- Clé primaire -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Token unique -->
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <!-- Référence vers l'utilisateur -->
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <!-- Date d'expiration -->
            <column name="expiry_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <!-- Indique si le token a été utilisé -->
            <column name="used" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Clé étrangère vers users -->
        <addForeignKeyConstraint
                baseTableName="password_reset_tokens"
                baseColumnNames="user_id"
                constraintName="fk_password_reset_tokens_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- Index pour améliorer les performances -->
        <createIndex indexName="idx_password_reset_tokens_token" tableName="password_reset_tokens">
            <column name="token"/>
        </createIndex>

        <createIndex indexName="idx_password_reset_tokens_user_id" tableName="password_reset_tokens">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>